{
  "name": "api-explorer",
  "publisher": "NehaDev",
  "license": "MIT",
  "repository": {
  "type": "git",
  "url": "https://github.com/NehaK745/api-explorer.git"
},
  "name": "rest-api-explorer-tree",
  "description": "new",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
"contributes": {
  "viewsContainers": {
    "activitybar": [
      {
        "id": "apiExplorer",
        "title": "API Explorer",
        "icon": "$(globe)"
      }
    ]
  },
  "views": {
    "apiExplorer": [
      {
        "id": "apiExplorer.resources",
        "name": "Resources"
      }
    ]
  },
  "commands": [
    { "command": "api-explorer.helloWorld", "title": "Hello World" },
    { "command": "api-explorer.shout", "title": "API Explorer: Shout Selection" },
    { "command": "api-explorer.setBaseUrl", "title": "API Explorer: Set Base URL" },
    { "command": "api-explorer.refresh", "title": "API Explorer: Refresh", "icon": "$(refresh)" },
    { "command": "api-explorer.openItem", "title": "API Explorer: Open Item" }
  ],
  "menus": {
    "view/title": [
      {
        "command": "api-explorer.refresh",
        "when": "view == apiExplorer.resources",
        "group": "navigation"
      }
    ],
    "commandPalette": [
      { "command": "api-explorer.openItem", "when": "false" }
    ]
  },
  "configuration": {
    "title": "API Explorer",
    "properties": {
      "apiExplorer.baseUrl": {
        "type": "string",
        "default": "https://jsonplaceholder.typicode.com",
        "description": "Base URL of the REST API to explore."
      },
      "apiExplorer.resources": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["posts", "users", "todos"],
        "description": "Endpoints to show as folders in the tree, e.g. products or users/1/posts."
      },
      "apiExplorer.queryString": {
        "type": "string",
        "default": "_limit=20",
        "description": "Query string added to every request, e.g. limit=20. Leave empty for none."
      }
    }
  }
},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.144.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
